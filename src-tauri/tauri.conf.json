{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIGF",
  "version": "0.1.0",
  "identifier": "ai.sigf.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SIGF",
        "width": 1360,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 680,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#050506",
        "center": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/appcache/librarycache/**"
        ]
      },
      "csp": "default-src 'self'; media-src https://sigf.ai; img-src 'self' data: asset: http://asset.localhost https://cdn.cloudflare.steamstatic.com https://shared.cloudflare.steamstatic.com https://shared.akamai.steamstatic.com https://cdn1.epicgames.com https://cdn2.unrealengine.com https://sigf.ai https://cdn.modrinth.com; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "sigf"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGNkQ4NUM1NEY3NzU1RTIKUldUaVZYZFB4WVZ0LzFqaHFDUEpiUmZCeFBmNkhUc2pncCtLdjB3ZjVNZEUyeElpZ3ZuSC8zVFYK",
      "endpoints": [
        "https://github.com/SIGFAI/sigf-app/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "SIGF",
    "copyright": "Copyright (C) 2026 SIGF contributors",
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Play game mashups in one click",
    "longDescription": "SIGF finds the games you own, installs game mashups in one click and restores your games with one more click. Open source (AGPL-3.0)."
  },
  "mainBinaryName": "SIGF"
}
